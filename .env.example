# Credenciales exclusivas para el modo local de desarrollo.
# No uses aqui la contraseña real de Firebase ni subas .env.local.
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=
VITE_USUARIO_EMAIL=
VITE_USUARIO_PASSWORD=
VITE_READONLY_EMAIL=
VITE_READONLY_PASSWORD=

# URL publica del servicio independiente de Minutas (sin secretos).
VITE_MINUTAS_SERVICE_URL=
